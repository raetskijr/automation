// --- ci: lab04/todo-app ---
pipeline {
    // --- где ---
    agent {
        label 'php-agent'
    }

    // --- опции ---
    options {
        // хранить 10 последних сборок
        buildDiscarder(logRotator(numToKeepStr: '10'))
        // одна сборка за раз
        disableConcurrentBuilds()
    }

    // --- этапы ---
    stages {
        stage('Install Dependencies') {
            steps {
                echo 'Preparing project...'
                dir('lab04/todo-app') {
                    // версии в лог
                    sh 'php -v | head -n 1 && composer --version'
                    // lock не хранится -> composer подбирает версии сам
                    sh 'composer install --no-interaction --no-progress'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                dir('lab04/todo-app') {
                    sh 'vendor/bin/phpunit --testsuite unit --colors=never'
                }
            }
        }
    }

    // --- итог ---
    post {
        always {
            echo 'Pipeline completed.'
        }
        success {
            echo 'All stages completed successfully!'
        }
        failure {
            echo 'Errors detected in the pipeline.'
        }
    }
}
